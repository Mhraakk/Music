# Copy to .env.local and fill in as needed. All values are optional —
# RESONANT runs fully on its local engine without any of these.

# Public base URL used for SEO metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://resonant.app

# Log verbosity: debug | info | warn | error (defaults: debug in dev, info in prod).
LOG_LEVEL=info

# Optional LLM provider key. When set, the agent reports llm=true; the local
# deterministic orchestrator is always the fallback.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Music sources (set these in backend/.env or as environment secrets)
#
# The open-internet sources — Apple/iTunes search, Deezer and MusicBrainz —
# need no credentials and work out of the box. Everything below connects one of
# your personal libraries. Each is independent: add only what you want.
# ---------------------------------------------------------------------------

# Spotify — https://developer.spotify.com/dashboard
# Client id/secret enable catalogue search. SPOTIFY_USER_TOKEN (an OAuth token
# with user-library-read) additionally unlocks your saved tracks and the audio
# features that make taste inference most accurate.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_USER_TOKEN=

# Apple Music — https://developer.apple.com/documentation/applemusicapi
# Developer token is a signed JWT from your Apple developer team.
# The user token comes from MusicKit authorization in the browser.
APPLE_MUSIC_DEVELOPER_TOKEN=
APPLE_MUSIC_USER_TOKEN=
APPLE_MUSIC_STOREFRONT=us

# YouTube Music — https://console.cloud.google.com (YouTube Data API v3)
# API key enables search; an OAuth token adds your liked music.
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_TOKEN=

# Telegram — create a bot with @BotFather and send/forward audio to it.
TELEGRAM_BOT_TOKEN=
