# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
# next-env.d.ts is deliberately NOT ignored: it is already tracked here, and
# ignoring a tracked file only hides the fact that Next rewrites it on build.

# production
/build

# typescript
*.tsbuildinfo

# testing
/coverage

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# vercel
.vercel
